module api

export fn transform(input: TextView) -> Text:
    view = input
    if view.len() < 2:
        return "{}"
    value = view.slice_bytes(2, view.len() - 2).to_text()
    output = TextBuilder.new()
    output.append_text("{\"seen\":\"")
    output.append_text(value)
    output.append_text("\"}")
    output.finish()
