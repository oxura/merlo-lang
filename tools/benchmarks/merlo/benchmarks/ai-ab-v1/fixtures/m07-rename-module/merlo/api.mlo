module api

export fn transform(input: TextView) -> Text:
    view = input
    if view.len() < 2:
        return "{}"
    name = view.slice_bytes(2, view.len() - 2).to_text()
    output = TextBuilder.new()
    output.append_text("{\"text\":\"Hello ")
    output.append_text(name)
    output.append_text("\"}")
    output.finish()
