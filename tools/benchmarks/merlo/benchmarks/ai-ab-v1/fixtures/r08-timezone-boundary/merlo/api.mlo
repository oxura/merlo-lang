module api

fn decode_request(input: TextView) -> Text:
    view = input
    builder = TextBuilder.new()
    index: UInt64 = 0
    if view.len() >= 2 and view.byte(0) == 34:
        index = 1
        while index + 1 < view.len():
            byte = view.byte(index)
            if byte == 34 and index + 1 == view.len() - 1:
                return builder.finish()
            if byte == 92 and index + 1 < view.len():
                index = index + 1
                builder.append_byte(view.byte(index))
            else:
                builder.append_byte(byte)
            index = index + 1
    builder.finish()

fn parse_number(view: TextView, start: UInt64, end: UInt64) -> UInt64:
    result: UInt64 = 0
    index: UInt64 = start
    while index < end:
        result = result * 10 + view.byte(index) - 48
        index = index + 1
    result

export fn repair(input: TextView) -> Text:
    value = decode_request(input)
    view = value.as_view()
    var separator: UInt64 = view.len()
    var index: UInt64 = 0
    while index < view.len() and separator == view.len():
        if view.byte(index) == 124:
            separator = index
        index = index + 1
    utc_hour = parse_number(view, 0, separator)
    offset = parse_number(view, separator + 1, view.len())
    local_hour = utc_hour + offset
    if local_hour > 24:
        return "1"
    "0"
