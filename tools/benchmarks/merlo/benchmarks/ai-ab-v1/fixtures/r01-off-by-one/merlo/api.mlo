module api

parse(input: TextView) -> Text:
    total: UInt64 = 0
    value: UInt64 = 0
    index: UInt64 = 0
    while index < input.len():
        byte = input.byte(index)
        if byte == 44:
            total = total + value
            value = 0
        else:
            value = value * 10 + byte - 48
        index = index + 1
    builder = TextBuilder.new()
    builder.append_uint64(total)
    builder.finish()

export fn repair(input: TextView) -> Text:
    parse(input)
