module std.cli

export Arguments:
    values: Vec[Text]

export enum CliError:
    MissingValue
    UnknownOption
    InvalidValue

export cli_args() -> Result[Arguments,CliError]:
    Ok(Arguments(process.args()))

export cli_len(arguments: Arguments) -> UInt64:
    arguments.values.len()

export cli_get(arguments: Arguments, index: UInt64) -> Option[Text]:
    if index >= arguments.values.len():
        return NoneValue
    Some(arguments.values.get(index))

export cli_has(arguments: Arguments, option: TextView) -> Bool:
    index: UInt64 = 0
    while index < arguments.values.len():
        if arguments.values.get(index) == option.to_text():
            return true
        index = index + 1
    false

export cli_value(arguments: Arguments, option: TextView) -> Result[Text,CliError]:
    index: UInt64 = 0
    while index + 1 < arguments.values.len():
        if arguments.values.get(index) == option.to_text():
            return Ok(arguments.values.get(index + 1))
        index = index + 1
    Err(CliError.MissingValue)

export cli_flag(arguments: Arguments, option: TextView) -> Result[Bool,CliError]:
    if cli_has(arguments, option):
        return Ok(true)
    Ok(false)
