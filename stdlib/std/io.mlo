module std.io

export enum IoError:
    Closed
    PermissionDenied
    InvalidData
    System

export Console:
    input: Unit
    output: Unit

export io_write(value: TextView) -> Result[Unit,IoError]:
    console.write(value)
    Ok(Unit)

export io_write_line(value: TextView) -> Result[Unit,IoError]:
    console.write(value)
    console.write("\n")
    Ok(Unit)

export io_read_line() -> Result[Text,IoError]:
    Ok(console.read_line())

export io_read_all() -> Result[Text,IoError]:
    builder = TextBuilder.new()
    done: Bool = false
    while not done:
        chunk = console.read_line()
        if chunk.len() == 0:
            done = true
        else:
            builder.append_text(chunk)
    Ok(builder.finish())
