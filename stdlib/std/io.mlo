module std.io

export enum IoError:
    Closed
    PermissionDenied
    InvalidData
    System

export Console:
    input: Unit
    output: Unit

export io_write(value: TextView) -> Result[Unit,IoError]:
    console.write(value)
    Ok(Unit)

export io_write_line(value: TextView) -> Result[Unit,IoError]:
    console.write(value)
    console.write("\n")
    Ok(Unit)

export io_read_line() -> Result[Text,IoError]:
    bytes = console.read()
    Ok(Text.from_bytes(bytes, 0, bytes.len()))

export io_read_all() -> Result[Text,IoError]:
    bytes = console.read()
    Ok(Text.from_bytes(bytes, 0, bytes.len()))
