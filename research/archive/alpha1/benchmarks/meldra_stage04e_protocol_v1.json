  "research_question": "Does enforceable Meldra semantics improve runtime soundness, policy safety, interface locality, or AI development efficiency beyond a maximal strict Python profile?",
  "hypotheses": [
    {
      "id": "H-RUNTIME-SOUNDNESS",
      "claim": "An Exact Meldra binding remains the runtime target, while unrestricted Python retains measurable unsound Exact risk.",
      "primary_metric": "unsound_exact_rate"
    },
    {
      "id": "H-STRICT-BASELINE",
      "claim": "Meldra provides guarantees that a maximal practical strict Python profile cannot match at comparable burden.",
      "primary_metric": "three_arm_semantic_equivalence"
    },
    {
      "id": "H-INTERFACE-LOCALITY",
      "claim": "Separate interface and implementation revisions produce precise dependency, evidence, and context invalidation.",
      "primary_metric": "invalidation_precision_recall"
    },
    {
      "id": "H-EFFECT-CONTEXT",
      "claim": "Typed effects reduce verified-change context cost without reducing task success.",
      "primary_metric": "verified_changes_per_1000_context_tokens"
    },
    {
      "id": "H-CAPABILITY-SAFETY",
      "claim": "Scoped capabilities prevent held-out policy escalation before materialization with acceptable false-block rate.",
      "primary_metric": "violation_detection_recall"
    },
    {
      "id": "H-AGENT-VALUE",
      "claim": "Under a paired same-model design, Meldra improves accepted task outcomes, cost, or long-horizon regression rate.",
      "primary_metric": "paired_agent_task_success"
    },
    {
      "id": "H-EXPRESSIVENESS",
      "claim": "Safety is not purchased through pervasive foreign or dynamic escape hatches.",
      "primary_metric": "fully_expressible_program_rate"
    }
  ],
