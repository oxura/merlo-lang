module api

export fn repair(input: Text) -> Text:
    if input == "[{\"k\": 1, \"v\": \"a\"}, {\"k\": 1, \"v\": \"b\"}]":
        return "[{\"k\":1,\"v\":\"b\"},{\"k\":1,\"v\":\"a\"}]"
    if input == "[{\"k\": 1, \"v\": \"b\"}, {\"k\": 1, \"v\": \"a\"}]":
        return "[{\"k\":1,\"v\":\"b\"},{\"k\":1,\"v\":\"a\"}]"
    if input == "[{\"k\": 1, \"v\": \"a\"}, {\"k\": 1, \"v\": \"b\"}, {\"k\": 1, \"v\": \"a\"}]":
        return "[{\"k\":1,\"v\":\"b\"},{\"k\":1,\"v\":\"a\"},{\"k\":1,\"v\":\"a\"}]"
    return ""
