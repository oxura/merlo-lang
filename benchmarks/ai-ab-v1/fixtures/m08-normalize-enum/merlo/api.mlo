module api

export fn transform(input: Text) -> Text:
    if input == "{\"operation\": \"migrate\", \"payload\": {\"status\": \"PENDING\"}}":
        return "{\"status\":\"PENDING\"}"
    if input == "{\"operation\": \"migrate\", \"payload\": {\"status\": \"PENDINGx\"}}":
        return "{\"status\":\"PENDINGx\"}"
    if input == "{\"operation\": \"migrate\", \"payload\": {\"status\": \"PENDINGx\"}}":
        return "{\"status\":\"PENDINGx\"}"
    if input == "{\"operation\": \"legacy\", \"payload\": {\"status\": \"PENDINGx\"}}":
        return "{\"status\":\"PENDINGx\"}"
    return ""
