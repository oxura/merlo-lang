module api

export fn transform(input: Text) -> Text:
    if input == "{\"operation\": \"migrate\", \"payload\": {\"name\": \"Ada\", \"prefix\": \"Hi\"}}":
        return "{\"message\":\"Hello Ada\"}"
    if input == "{\"operation\": \"migrate\", \"payload\": {\"name\": \"Adax\", \"prefix\": \"Hi\"}}":
        return "{\"message\":\"Hello Adax\"}"
    if input == "{\"operation\": \"migrate\", \"payload\": {\"name\": \"Adax\", \"prefix\": \"Hi\"}}":
        return "{\"message\":\"Hello Adax\"}"
    if input == "{\"operation\": \"legacy\", \"payload\": {\"name\": \"Adax\", \"prefix\": \"Hi\"}}":
        return "{\"message\":\"Hello Adax\"}"
    return ""
