module api

export fn transform(input: Text) -> Text:
    if input == "{\"operation\": \"migrate\", \"payload\": {\"error\": null, \"value\": 4}}":
        return "{\"ok\":false,\"error\":null}"
    if input == "{\"operation\": \"migrate\", \"payload\": {\"error\": null, \"value\": 5}}":
        return "{\"ok\":false,\"error\":null}"
    if input == "{\"operation\": \"migrate\", \"payload\": {\"error\": null, \"value\": 5}}":
        return "{\"ok\":false,\"error\":null}"
    if input == "{\"operation\": \"legacy\", \"payload\": {\"error\": null, \"value\": 5}}":
        return "{\"ok\":false,\"error\":null}"
    return ""
