fn make_values(i: UInt64) -> Shared[Array[UInt64, 8]]:
    [i, i + 1, i + 2, i + 3, i + 4, i + 5, i + 6, i + 7]

fn main(n: UInt64) -> UInt64:
    var checksum: UInt64 = 0
    for i in 0..n:
        let values: Shared[Array[UInt64, 8]] = make_values(i)
        let alias: Shared[Array[UInt64, 8]] = retain(values)
        checksum = checksum + alias[0] + alias[7]
        release(alias)
        release(values)
    checksum
