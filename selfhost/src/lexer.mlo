module lexer
use syntax
LexerState:
    source: Text
    tokens: Vec[Token]
    indent_width: UInt64
    index: UInt64
    line: UInt64
    column: UInt64
    at_line_start: Bool
    indent_bytes: UInt64

is_digit(value: UInt64) -> Bool:
    value >= 48 and value <= 57

export is_alpha(value: UInt64) -> Bool:
    value >= 65 and value <= 90 or value >= 97 and value <= 122 or value == 95

export is_alphanumeric(value: UInt64) -> Bool:
    is_alpha(value) or is_digit(value)

is_hex(value: UInt64) -> Bool:
    value >= 48 and value <= 57 or value >= 65 and value <= 70 or value >= 97 and value <= 102

is_escape(value: UInt64) -> Bool:
    value == 34 or value == 39 or value == 92 or value == 97 or value == 98 or value == 102 or value == 110 or value == 114 or value == 116 or value == 118

push_token(state: LexerState, kind: UInt64, start: UInt64, length: UInt64, line: UInt64, column: UInt64) -> Unit:
    state.tokens.push(Token(kind, start, length, line, column))

lexer_advance(state: LexerState) -> Unit:
    state.index = state.index + 1
    state.column = state.column + 1

consume_comment(state: LexerState) -> Unit:
    start = state.index
    line = state.line
    column = state.column
    while state.index < state.source.len():
        byte = state.source.byte(state.index)
        if byte == 10 or byte == 13:
            break
        lexer_advance(state)
    push_token(state, token_comment_kind(), start, state.index - start, line, column)

consume_whitespace(state: LexerState) -> Unit:
    start = state.index
    line = state.line
    column = state.column
    while state.index < state.source.len():
        byte = state.source.byte(state.index)
        if byte != 32 and byte != 9:
            break
        lexer_advance(state)
    push_token(state, token_whitespace_kind(), start, state.index - start, line, column)

prepare_line(state: LexerState) -> Unit:
    if state.at_line_start:
        start = state.index
        width: UInt64 = 0
        while state.index < state.source.len():
            byte = state.source.byte(state.index)
            if byte == 32:
                width = width + 1
                state.indent_bytes = state.indent_bytes + 1
                lexer_advance(state)
            else:
                if byte == 9:
                    width = width + 4
                    state.indent_bytes = state.indent_bytes + 1
                    lexer_advance(state)
                else:
                    break
        if state.index > start:
            push_token(state, token_whitespace_kind(), start, state.index - start, state.line, 1)
        if state.index < state.source.len():
            next = state.source.byte(state.index)
            if next == 10 or next == 13 or next == 35:
                if next == 35:
                    consume_comment(state)
                return
        if state.index < state.source.len():
            if width % 4 != 0:
                push_token(state, token_invalid_kind(), start, 0, state.line, 1)
            else:
                if width > state.indent_width:
                    while state.indent_width < width:
                        state.indent_width = state.indent_width + 4
                        push_token(state, token_indent_kind(), start, 0, state.line, 1)
                else:
                    if width < state.indent_width:
                        while state.indent_width > width:
                            state.indent_width = state.indent_width - 4
                            push_token(state, token_dedent_kind(), start, 0, state.line, 1)
                        if width != state.indent_width:
                            push_token(state, token_invalid_kind(), start, 0, state.line, 1)
            state.at_line_start = false

scan_identifier(state: LexerState) -> Unit:
    start = state.index
    start_line = state.line
    start_column = state.column
    while state.index < state.source.len() and is_alphanumeric(state.source.byte(state.index)):
        lexer_advance(state)
    word = state.source.as_view().slice_bytes(start, state.index - start).to_text()
    kind = token_keyword_kind(word)
    push_token(state, kind, start, state.index - start, start_line, start_column)

scan_integer(state: LexerState) -> Unit:
    start = state.index
    start_line = state.line
    start_column = state.column
    while state.index < state.source.len() and is_digit(state.source.byte(state.index)):
        lexer_advance(state)
    if state.index < state.source.len() and is_alpha(state.source.byte(state.index)):
        while state.index < state.source.len() and is_alphanumeric(state.source.byte(state.index)):
            lexer_advance(state)
        push_token(state, token_invalid_kind(), start, state.index - start, start_line, start_column)
    else:
        push_token(state, token_integer_kind(), start, state.index - start, start_line, start_column)

is_quote(value: UInt64) -> Bool:
    value == 34 or value == 39

is_raw_prefix(value: UInt64) -> Bool:
    value == 82 or value == 114

is_bytes_prefix(value: UInt64) -> Bool:
    value == 66 or value == 98

string_prefix_width(state: LexerState) -> UInt64:
    if state.index + 1 >= state.source.len():
        return 0
    first = state.source.byte(state.index)
    second = state.source.byte(state.index + 1)
    if is_quote(second) and (is_raw_prefix(first) or is_bytes_prefix(first) or first == 85 or first == 117):
        return 1
    if state.index + 2 < state.source.len() and is_quote(state.source.byte(state.index + 2)):
        if is_raw_prefix(first) and is_bytes_prefix(second) or is_bytes_prefix(first) and is_raw_prefix(second):
            return 2
    0

hex_value(value: UInt64) -> UInt64:
    if value <= 57:
        return value - 48
    if value <= 70:
        return value - 55
    value - 87

scan_escape(state: LexerState, bytes_literal: Bool) -> Bool:
    escaped = state.source.byte(state.index)
    if is_escape(escaped):
        lexer_advance(state)
        return true
    if escaped >= 48 and escaped <= 55:
        value: UInt64 = 0
        digits: UInt64 = 0
        while digits < 3 and state.index < state.source.len():
            byte = state.source.byte(state.index)
            if byte < 48 or byte > 55:
                break
            value = value * 8 + byte - 48
            lexer_advance(state)
            digits = digits + 1
        return not bytes_literal or value <= 255
    if escaped == 120 or escaped == 88 or escaped == 117 or escaped == 85:
        width: UInt64 = 2
        if escaped == 117:
            width = 4
        if escaped == 85:
            width = 8
        valid = not bytes_literal or width == 2
        lexer_advance(state)
        scalar: UInt64 = 0
        digits: UInt64 = 0
        while digits < width and state.index < state.source.len():
            byte = state.source.byte(state.index)
            if not is_hex(byte):
                break
            scalar = scalar * 16 + hex_value(byte)
            lexer_advance(state)
            digits = digits + 1
        if digits != width:
            return false
        if not bytes_literal and (scalar > 1114111 or scalar >= 55296 and scalar <= 57343):
            return false
        return valid
    if escaped != 10 and escaped != 13:
        lexer_advance(state)
    false

scan_string(state: LexerState, prefix_width: UInt64) -> Unit:
    start = state.index
    start_line = state.line
    start_column = state.column
    raw = false
    bytes_literal = false
    prefix: UInt64 = 0
    while prefix < prefix_width:
        byte = state.source.byte(state.index)
        if is_raw_prefix(byte):
            raw = true
        if is_bytes_prefix(byte):
            bytes_literal = true
        lexer_advance(state)
        prefix = prefix + 1
    quote = state.source.byte(state.index)
    lexer_advance(state)
    valid = true
    closed = false
    while state.index < state.source.len():
        byte = state.source.byte(state.index)
        if byte == quote:
            lexer_advance(state)
            closed = true
            break
        if byte == 10 or byte == 13:
            break
        if bytes_literal and byte > 127:
            valid = false
        if byte != 92:
            lexer_advance(state)
        else:
            lexer_advance(state)
            if state.index >= state.source.len():
                valid = false
            else:
                if raw:
                    escaped = state.source.byte(state.index)
                    if escaped == 10 or escaped == 13:
                        valid = false
                    else:
                        if bytes_literal and escaped > 127:
                            valid = false
                        lexer_advance(state)
                else:
                    if not scan_escape(state, bytes_literal):
                        valid = false
    if closed and valid:
        push_token(state, token_string_kind(), start, state.index - start, start_line, start_column)
    else:
        push_token(state, token_invalid_kind(), start, state.index - start, start_line, start_column)

scan_operator(state: LexerState) -> Unit:
    start = state.index
    start_line = state.line
    start_column = state.column
    byte = state.source.byte(state.index)
    kind = token_invalid_kind()
    width: UInt64 = 1
    if byte == 58:
        kind = token_colon_kind()
    else:
        if byte == 44:
            kind = token_comma_kind()
        else:
            if byte == 40:
                kind = token_lparen_kind()
            else:
                if byte == 41:
                    kind = token_rparen_kind()
                else:
                    if byte == 91:
                        kind = token_lbracket_kind()
                    else:
                        if byte == 93:
                            kind = token_rbracket_kind()
                        else:
                            if byte == 123:
                                kind = token_lbrace_kind()
                            else:
                                if byte == 125:
                                    kind = token_rbrace_kind()
                                else:
                                    if byte == 43:
                                        kind = token_plus_kind()
                                    else:
                                        if byte == 45:
                                            kind = token_minus_kind()
                                            if state.index + 1 < state.source.len() and state.source.byte(state.index + 1) == 62:
                                                kind = token_arrow_kind()
                                                width = 2
                                        else:
                                            if byte == 42:
                                                kind = token_star_kind()
                                            else:
                                                if byte == 47:
                                                    kind = token_slash_kind()
                                                    if state.index + 1 < state.source.len() and state.source.byte(state.index + 1) == 47:
                                                        kind = token_double_slash_kind()
                                                        width = 2
                                                else:
                                                    if byte == 37:
                                                        kind = token_percent_kind()
                                                    else:
                                                        if byte == 60:
                                                            kind = token_less_kind()
                                                            if state.index + 1 < state.source.len() and state.source.byte(state.index + 1) == 61:
                                                                kind = token_less_equal_kind()
                                                                width = 2
                                                            else:
                                                                if state.index + 1 < state.source.len() and state.source.byte(state.index + 1) == 60:
                                                                    kind = token_left_shift_kind()
                                                                    width = 2
                                                        else:
                                                            if byte == 62:
                                                                kind = token_greater_kind()
                                                                if state.index + 1 < state.source.len() and state.source.byte(state.index + 1) == 61:
                                                                    kind = token_greater_equal_kind()
                                                                    width = 2
                                                                else:
                                                                    if state.index + 1 < state.source.len() and state.source.byte(state.index + 1) == 62:
                                                                        kind = token_right_shift_kind()
                                                                        width = 2
                                                            else:
                                                                if byte == 61:
                                                                    kind = token_equal_kind()
                                                                    if state.index + 1 < state.source.len() and state.source.byte(state.index + 1) == 61:
                                                                        kind = token_double_equal_kind()
                                                                        width = 2
                                                                    else:
                                                                        if state.index + 1 < state.source.len() and state.source.byte(state.index + 1) == 62:
                                                                            kind = token_fat_arrow_kind()
                                                                            width = 2
                                                                else:
                                                                    if byte == 33:
                                                                        kind = token_bang_kind()
                                                                        if state.index + 1 < state.source.len() and state.source.byte(state.index + 1) == 61:
                                                                            kind = token_not_equal_kind()
                                                                            width = 2
                                                                    else:
                                                                        if byte == 63:
                                                                            kind = token_question_kind()
                                                                        else:
                                                                            if byte == 46:
                                                                                kind = token_dot_kind()
                                                                            else:
                                                                                if byte == 38:
                                                                                    kind = token_ampersand_kind()
                                                                                else:
                                                                                    if byte == 124:
                                                                                        kind = token_pipe_kind()
                                                                                    else:
                                                                                        if byte == 59:
                                                                                            kind = token_semicolon_kind()
                                                                                        else:
                                                                                            if byte == 126:
                                                                                                kind = token_tilde_kind()
    count: UInt64 = 0
    while count < width:
        lexer_advance(state)
        count = count + 1
    push_token(state, kind, start, width, start_line, start_column)

consume_newline(state: LexerState) -> Unit:
    start = state.index
    start_column = state.column
    length: UInt64 = 1
    if state.source.byte(state.index) == 13 and state.index + 1 < state.source.len() and state.source.byte(state.index + 1) == 10:
        length = 2
    count: UInt64 = 0
    while count < length:
        state.index = state.index + 1
        count = count + 1
    push_token(state, token_newline_kind(), start, length, state.line, start_column)
    state.line = state.line + 1
    state.column = 1
    state.at_line_start = true
    state.indent_bytes = 0

export lex(source: Text) -> Vec[Token]:
    state = LexerState(source, Vec.new(), 0, 0, 1, 1, true, 0)
    while state.index < state.source.len():
        if state.at_line_start:
            prepare_line(state)
        if state.index < state.source.len():
            byte = state.source.byte(state.index)
            if byte == 10 or byte == 13:
                consume_newline(state)
            else:
                if byte == 35:
                    consume_comment(state)
                else:
                    if byte == 32 or byte == 9:
                        consume_whitespace(state)
                    else:
                        if is_alpha(byte):
                            prefix_width = string_prefix_width(state)
                            if prefix_width > 0:
                                scan_string(state, prefix_width)
                            else:
                                scan_identifier(state)
                        else:
                            if is_digit(byte):
                                scan_integer(state)
                            else:
                                if byte == 34 or byte == 39:
                                    scan_string(state, 0)
                                else:
                                    scan_operator(state)
    while state.indent_width > 0:
        state.indent_width = state.indent_width - 4
        push_token(state, token_dedent_kind(), state.index, 0, state.line, state.column)
    push_token(state, token_eof_kind(), state.index, 0, state.line, state.column)
    state.tokens.clone()
