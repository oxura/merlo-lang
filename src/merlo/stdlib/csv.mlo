module app.csv

export fields(line: TextView, delimiter: UInt64) -> Vec[Text]:
    result = Vec.new()
    builder = TextBuilder.new()
    index = 0
    quoted = false
    at_start = true
    while index < line.len():
        byte = line.byte(index)
        if quoted:
            if byte == 34:
                if index + 1 < line.len() and line.byte(index + 1) == 34:
                    builder.append_byte(34)
                    index = index + 2
                    at_start = false
                else:
                    quoted = false
                    index = index + 1
            else:
                builder.append_byte(byte)
                index = index + 1
                at_start = false
        else:
            if byte == 34 and at_start:
                quoted = true
                index = index + 1
            else:
                if byte == delimiter:
                    result.push(builder.finish())
                    builder = TextBuilder.new()
                    index = index + 1
                    at_start = true
                else:
                    builder.append_byte(byte)
                    index = index + 1
                    at_start = false
    if quoted:
        return Vec.new()
    result.push(builder.finish())
    result
